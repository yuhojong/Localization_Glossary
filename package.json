{
  "name": "navi-localization-glossary",
  "version": "0.1.0",
  "description": "StudioNavi glossary search tool for KO/EN localization data",
  "main": "electron/main.js",
  "author": "OpenAI Codex",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder",
    "build:package": "electron-builder",
    "release": "node scripts/build-release.js",
    "release:publish": "node scripts/build-release.js --publish-build-state",
    "start": "electron ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^35.1.5",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.1",
    "typescript": "^5.8.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.studionavi.localizationglossary",
    "productName": "Navi Localization Glossary",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data"
      },
      {
        "from": "build",
        "to": "build"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
